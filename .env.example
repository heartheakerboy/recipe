# ==============================================================================
# FlavorNest.xyz Environment Configuration
# ==============================================================================
# NOTE: Never commit real API keys or production secrets to source control.
# Copy this file to .env.local for local development.

# Application Settings
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=FlavorNest
NEXT_PUBLIC_SITE_DOMAIN=flavornest.xyz

# Cloudflare D1 Database (Future Production Bindings)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_placeholder
CLOUDFLARE_D1_DATABASE_ID=your_d1_database_id_placeholder
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_placeholder

# Cloudflare R2 Storage (Media / Images)
R2_ACCOUNT_ID=your_r2_account_id_placeholder
R2_ACCESS_KEY_ID=your_r2_access_key_placeholder
R2_SECRET_ACCESS_KEY=your_r2_secret_key_placeholder
R2_BUCKET_NAME=flavornest-media
NEXT_PUBLIC_R2_PUBLIC_URL=https://images.flavornest.xyz

# AI Recipe Content Pipeline (LLM Providers)
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_placeholder
ANTHROPIC_API_KEY=your_anthropic_api_key_placeholder
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_placeholder

# FLUX Image Generation Provider
IMAGE_GEN_PROVIDER=bfl
FLUX_API_KEY=your_flux_api_key_placeholder
FLUX_API_ENDPOINT=https://api.bfl.ml/v1/flux-pro-1.1

# Future Pinterest API & Automation
PINTEREST_APP_ID=your_pinterest_app_id_placeholder
PINTEREST_APP_SECRET=your_pinterest_app_secret_placeholder
PINTEREST_REFRESH_TOKEN=your_pinterest_refresh_token_placeholder

# Admin Security
ADMIN_API_SECRET_KEY=generate_a_secure_random_string_for_internal_cron_and_jobs
